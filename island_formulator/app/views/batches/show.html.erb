<div class="mx-auto w-full max-w-3xl px-5 py-10">

  <div class="rounded-2xl border border-amber-200 bg-white/90 p-8 shadow-sm">

    <div class="flex justify-between items-start mb-8">
      <div>
        <p class="text-sm font-semibold tracking-wide text-emerald-900/80 uppercase">
          Batch Log
        </p>

        <h1 class="mt-2 text-4xl font-extrabold text-emerald-950">
          <%= @batch.recipe.title %>
        </h1>

        <p class="mt-2 text-stone-600">
          Made on <%= @batch.made_on.strftime("%A, %B %d, %Y") %>
        </p>
      </div>

      <%= link_to "View Recipe",
        @batch.recipe,
        class: "inline-flex items-center justify-center rounded-md border border-amber-200 bg-white px-4 py-2 text-sm font-semibold text-stone-700 hover:bg-amber-50" %>
    </div>


    <!-- Ingredients -->
    <div class="mb-10">

      <h2 class="text-sm font-semibold uppercase tracking-wide text-emerald-900/80 mb-4">
        Ingredients Used
      </h2>

      <div class="rounded-xl border border-amber-200 bg-rose-50/40 p-6">

        <ul class="divide-y divide-amber-100">

          <% @batch.recipe.recipe_ingredients.each do |ri| %>

            <li class="py-3 flex justify-between">

              <span class="font-medium text-emerald-950">
                <%= ri.ingredient.name %>
              </span>

              <span class="text-stone-600 bg-white px-3 py-1 rounded-md text-sm border border-amber-100">
                <%= ri.quantity %>
              </span>

            </li>

          <% end %>

        </ul>

      </div>

    </div>


    <!-- Notes -->
    <% if @batch.notes.present? %>

      <div class="mb-10">

        <h2 class="text-sm font-semibold uppercase tracking-wide text-emerald-900/80 mb-4">
          Production Notes
        </h2>

        <div class="rounded-xl border border-amber-200 bg-rose-50/40 p-6 text-stone-700 italic">
          <%= simple_format @batch.notes %>
        </div>

      </div>

    <% end %>


    <!-- Footer -->
    <div class="flex justify-between items-center pt-6 border-t border-amber-100">

      <%= link_to "Back to History",
        batches_path,
        class: "inline-flex items-center justify-center rounded-md border border-amber-200 bg-white px-4 py-2 text-sm font-semibold text-stone-700 hover:bg-amber-50" %>

      <%= button_to "Delete Log",
        @batch,
        method: :delete,
        class: "text-red-600 text-sm font-semibold hover:underline",
        data: { confirm: "Are you sure you want to delete this batch log?" } %>

    </div>

  </div>

</div>