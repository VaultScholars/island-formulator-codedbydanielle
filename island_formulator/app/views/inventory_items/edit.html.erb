<% content_for :title, "Edit Inventory Item" %>

<div class="mx-auto w-full max-w-3xl px-5 py-10">

  <div class="mb-8 flex items-start justify-between gap-4">
    <div>
      <p class="text-sm font-semibold tracking-wide text-emerald-900/80 uppercase">
        Inventory
      </p>

      <h1 class="mt-2 text-4xl font-extrabold text-emerald-950">
        Edit Inventory Item
      </h1>

      <p class="mt-2 text-sm text-stone-600">
        Update details about this purchase—brand, size, storage location, or notes.
      </p>
    </div>
  </div>

  <%= render "form", inventory_item: @inventory_item %>

  <div class="mt-6 flex flex-wrap gap-3">

    <%= link_to "View Item",
      @inventory_item,
      class: "rounded-lg border border-amber-200 px-5 py-2.5 text-sm font-semibold text-stone-700 hover:bg-amber-50 transition" %>

    <%= link_to "Back to Inventory",
      inventory_items_path,
      class: "rounded-lg border border-amber-200 px-5 py-2.5 text-sm font-semibold text-stone-700 hover:bg-amber-50 transition" %>

  </div>

</div>