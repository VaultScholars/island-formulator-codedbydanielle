<% content_for :title, "Sign In" %>

<div class="min-h-screen bg-gradient-to-br from-emerald-50 via-rose-50 to-emerald-100/60 py-16 px-5">
  <div class="mx-auto w-full max-w-md">

    <% if alert = flash[:alert] %>
      <p id="alert"
         class="mb-5 inline-block rounded-xl border border-rose-200 bg-rose-50 px-4 py-2 text-sm font-semibold text-rose-800">
        <%= alert %>
      </p>
    <% end %>

    <% if notice = flash[:notice] %>
      <p id="notice"
         class="mb-5 inline-block rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-2 text-sm font-semibold text-emerald-800">
        <%= notice %>
      </p>
    <% end %>

    <div class="rounded-2xl border border-amber-200 bg-white/90 p-8 shadow-sm backdrop-blur-sm">

      <div class="mb-8 text-center">
        <p class="text-sm font-semibold tracking-wide text-emerald-900/80 uppercase">
          Island Formulator
        </p>

        <h1 class="mt-2 text-3xl font-extrabold text-emerald-950">
          Sign In
        </h1>

        <p class="mt-2 text-sm text-stone-600">
          Welcome back to your formulation lab.
        </p>
      </div>

      <%= form_with url: session_url, class: "space-y-5" do |form| %>
        <div>
          <%= form.label :email_address, "Email Address",
            class: "block text-sm font-semibold text-emerald-950 mb-1" %>

          <%= form.email_field :email_address,
            required: true,
            autofocus: true,
            autocomplete: "username",
            placeholder: "Enter your email address",
            value: params[:email_address],
            class: "w-full rounded-md border border-amber-100 bg-white/80 px-3 py-2 shadow-sm placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-emerald-700/30 focus:border-emerald-700" %>
        </div>

        <div>
          <%= form.label :password, "Password",
            class: "block text-sm font-semibold text-emerald-950 mb-1" %>

          <%= form.password_field :password,
            required: true,
            autocomplete: "current-password",
            placeholder: "Enter your password",
            maxlength: 72,
            class: "w-full rounded-md border border-amber-100 bg-white/80 px-3 py-2 shadow-sm placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-emerald-700/30 focus:border-emerald-700" %>
        </div>

        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <%= form.submit "Sign In",
            class: "inline-flex items-center justify-center rounded-md bg-emerald-900 px-5 py-2.5 text-sm font-semibold text-rose-50 shadow-sm hover:bg-emerald-800 focus:outline-none focus:ring-2 focus:ring-emerald-700/40 transition" %>

          <%= link_to "Forgot password?",
            new_password_path,
            class: "text-sm font-medium text-stone-600 underline hover:text-emerald-900 hover:no-underline" %>
        </div>
      <% end %>

      <div class="mt-6 text-center text-sm text-stone-600">
        Don’t have an account?
        <%= link_to "Create one",
          new_user_path,
          class: "font-semibold text-emerald-700 hover:text-emerald-950 hover:underline" %>
      </div>

    </div>
  </div>
</div>