<% content_for :title, "Ingredients" %>

<div class="mx-auto w-full max-w-6xl px-5 py-10">

  <div class="mb-8 flex items-start justify-between gap-4">
    <div>
      <p class="text-sm font-semibold tracking-wide text-emerald-900/80 uppercase">
        Ingredient Tracker
      </p>

      <h1 class="mt-2 text-4xl font-extrabold text-emerald-950">
        Ingredient Shelf
      </h1>

      <p class="mt-2 text-sm text-stone-600">
        Organize the raw materials in your formulation lab and keep track of what’s available.
      </p>
    </div>

    <%= link_to "Add New Ingredient",
      new_ingredient_path,
      class: "bg-emerald-900 hover:bg-emerald-800 text-rose-50 font-semibold px-5 py-3 rounded-lg shadow-sm transition" %>
  </div>


  <div id="ingredients" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">

    <% @ingredients.each do |ingredient| %>

    <div class="group bg-rose-200 rounded-2xl border border-amber-200 shadow-lg hover:shadow-xl transition-all duration-300 overflow-hidden">

  <div class="h-1 w-full bg-gradient-to-r from-emerald-700 via-emerald-500 to-emerald-700"></div>

  <div class="p-6 bg-white/80 backdrop-blur-sm">

    <div class="mb-4">
      <span class="inline-block px-3 py-1 text-xs font-semibold tracking-wide uppercase rounded-full
                   bg-emerald-100 text-emerald-900 border border-emerald-200">
        <%= ingredient.category %>
      </span>
    </div>

    <h2 class="text-xl font-bold text-emerald-950 mb-2">
      <%= ingredient.name %>
    </h2>

    <p class="text-stone-700 line-clamp-3 mb-4">
      <%= ingredient.description %>
    </p>

    <div class="mt-auto pt-4 border-t border-amber-100 flex justify-between items-center">

      <%= link_to "View Details",
        ingredient,
        class: "text-emerald-700 font-semibold hover:text-emerald-950 transition" %>

      <span class="text-stone-400 text-sm">
        #<%= ingredient.id %>
      </span>

    </div>

  </div>

</div>

    <% end %>

  </div>

</div>