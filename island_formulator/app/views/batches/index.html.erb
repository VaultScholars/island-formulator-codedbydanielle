<% content_for :title, "Batch History" %>

<div class="mx-auto w-full max-w-6xl px-5 py-10">
  <% if notice.present? %>
    <p id="notice"
       class="mb-6 inline-block rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-2 text-sm font-semibold text-emerald-800">
      <%= notice %>
    </p>
  <% end %>

  <div class="mb-8 flex items-start justify-between gap-4">
    <div>
      <p class="text-sm font-semibold tracking-wide text-emerald-900/80 uppercase">
        Production Log
      </p>
      <h1 class="mt-2 text-4xl font-extrabold text-emerald-950">
        Batch History
      </h1>
      <p class="mt-2 text-sm text-stone-600">
        Keep track of what you made, when you made it, and any notes from production.
      </p>
    </div>

    <%= link_to "Log New Batch",
      new_batch_path,
      class: "rounded-lg bg-emerald-900 px-5 py-3 text-base font-semibold text-rose-50 shadow-sm transition hover:bg-emerald-800" %>
  </div>

  <div id="batches" class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2">
    <% @batches.each do |batch| %>
      <div class="rounded-2xl border border-amber-200 bg-rose-50 p-6 shadow-lg">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h2 class="text-xl font-extrabold text-emerald-950">
        <%= batch.recipe.title %>
      </h2>
      <p class="mt-1 text-sm text-stone-500">
        <%= batch.made_on.strftime("%B %d, %Y") %>
      </p>
    </div>

    <%= link_to "View Details",
      batch,
      class: "text-sm font-semibold text-emerald-800 hover:text-emerald-950 hover:underline" %>
  </div>

  <% if batch.notes.present? %>
    <div class="mt-4 rounded-xl border border-amber-100 bg-white/80 backdrop-blur-sm px-4 py-3 text-sm italic text-stone-600">
      “<%= batch.notes.truncate(100) %>”
    </div>
  <% end %>
    </div>
    <% end %>

    <% if @batches.empty? %>
      <div class="col-span-full rounded-2xl border border-amber-200 bg-rose-50/40 px-6 py-10 text-center shadow-sm">
        <p class="text-stone-500">No batches logged yet. Go make something!</p>
      </div>
    <% end %>
  </div>
</div>