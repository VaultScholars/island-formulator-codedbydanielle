<div class="mx-auto w-full max-w-3xl px-6 py-10 flex flex-col items-center">

  <div class="w-full rounded-2xl border border-amber-200 bg-white p-8 shadow-sm">

    <div class="flex justify-between items-start mb-6">
      <div>
        <h1 class="text-3xl font-extrabold text-emerald-950">
          <%= @inventory_item.ingredient.name %>
        </h1>

        <p class="text-stone-500 mt-1">
          <%= @inventory_item.brand.presence || "No brand specified" %>
        </p>
      </div>

      <span class="rounded-full border border-emerald-200 bg-emerald-100 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-emerald-900">
        <%= @inventory_item.ingredient.category %>
      </span>
    </div>

    <% if @inventory_item.photo.attached? %>
      <div class="mb-6">
        <%= image_tag @inventory_item.photo, class: "w-full h-64 object-cover rounded-2xl border border-amber-200 shadow-sm" %>
      </div>
    <% end %>

    <div class="grid grid-cols-2 gap-6 mb-8">
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-emerald-900/70">
          Size
        </p>
        <p class="text-lg font-medium text-stone-700">
          <% if @inventory_item.unit_size.present? && @inventory_item.unit.present? %>
          <%= @inventory_item.unit_size %> <%= @inventory_item.unit %>
        <% else %>
          Not specified
        <% end %>
      </p>
        </p>
      </div>

      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-emerald-900/70">
          Location
        </p>
        <p class="text-lg font-medium text-stone-700">
          <%= @inventory_item.location.presence || "Not specified" %>
        </p>
      </div>

      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-emerald-900/70">
          Purchase Date
        </p>
        <p class="text-lg font-medium text-stone-700">
          <%= @inventory_item.purchase_date.strftime("%B %d, %Y") %>
        </p>
      </div>
    </div>

    <% if @inventory_item.notes.present? %>
      <div class="mb-8">
        <p class="text-xs font-bold uppercase tracking-widest text-emerald-900/70 mb-2">
          Notes
        </p>

        <div class="rounded-xl border border-amber-200 bg-rose-50/40 p-4 text-stone-700">
          <%= simple_format @inventory_item.notes %>
        </div>
      </div>
    <% end %>

    <div class="flex flex-wrap gap-3">

      <%= link_to "Edit this item",
        edit_inventory_item_path(@inventory_item),
        class: "rounded-lg bg-emerald-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-emerald-800 transition" %>

      <%= button_to "Remove from inventory",
        @inventory_item,
        method: :delete,
        class: "rounded-lg bg-rose-100 border border-rose-200 px-5 py-2.5 text-sm font-semibold text-rose-700 hover:bg-rose-200 transition",
        data: { turbo_confirm: "Are you sure?" } %>

      <%= link_to "Back to inventory",
        inventory_items_path,
        class: "ml-auto rounded-lg border border-amber-200 px-5 py-2.5 text-sm font-semibold text-stone-700 hover:bg-amber-50 transition" %>

    </div>

  </div>

</div>