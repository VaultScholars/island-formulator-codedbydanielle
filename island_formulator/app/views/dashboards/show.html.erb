<div class="min-h-screen bg-gradient-to-br from-emerald-100 via-green-50 to-emerald-200/70 relative overflow-hidden py-10">  
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,rgba(255,255,255,0.7),transparent_40%),radial-gradient(circle_at_80%_0%,rgba(255,255,255,0.5),transparent_40%)] pointer-events-none"></div>
    <div class="mx-auto w-full max-w-7xl px-6 relative">
  <!-- Hero -->
  <div class="mb-10 rounded-[28px] border border-amber-300 bg-gradient-to-br from-rose-100 via-pink-100 to-rose-150/60 p-8 shadow-sm">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <p class="text-sm font-semibold tracking-[0.22em] text-emerald-900/70 uppercase">
          Dashboard
        </p>
        <h1 class="mt-3 text-4xl md:text-5xl font-extrabold tracking-tight text-emerald-950">
          Welcome back, <%= current_user.email_address.split('@').first.capitalize %>!
        </h1>
        <p class="mt-3 max-w-2xl text-sm md:text-base text-stone-600 leading-relaxed">
          A refined overview of your ingredient library, recipes, inventory, and production activity.
        </p>
      </div>

      <div class="self-start lg:self-auto rounded-full border border-amber-300 bg-white/80 px-5 py-2 text-sm font-medium text-stone-500 shadow-sm">
        <%= Time.now.strftime("%A, %B %d, %Y") %>
      </div>
    </div>
  </div>

  <!-- Stats -->
  <div class="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-4 mb-10">
    <div class="group rounded-[24px] border border-amber-300 bg-white/95 backdrop-blur-sm/95 p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg transition">
      <div class="mb-4 h-1.5 w-14 rounded-full bg-emerald-200"></div>
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-emerald-900/60">Ingredients</p>
      <p class="mt-4 text-4xl font-extrabold text-emerald-950"><%= @stats[:ingredients] %></p>
      <%= link_to "View all →", ingredients_path, class: "mt-5 inline-block text-sm font-semibold text-emerald-800 hover:text-emerald-950 hover:underline" %>
    </div>

    <div class="group rounded-[24px] border border-amber-300 bg-white/95 backdrop-blur-sm/95 p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg transition">
      <div class="mb-4 h-1.5 w-14 rounded-full bg-rose-200"></div>
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-emerald-900/60">Recipes</p>
      <p class="mt-4 text-4xl font-extrabold text-emerald-950"><%= @stats[:recipes] %></p>
      <%= link_to "View all →", recipes_path, class: "mt-5 inline-block text-sm font-semibold text-emerald-800 hover:text-emerald-950 hover:underline" %>
    </div>

    <div class="group rounded-[24px] border border-amber-300 bg-white/95 backdrop-blur-sm/95 p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg transition">
      <div class="mb-4 h-1.5 w-14 rounded-full bg-amber-300"></div>
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-emerald-900/60">Inventory Items</p>
      <p class="mt-4 text-4xl font-extrabold text-emerald-950"><%= @stats[:inventory] %></p>
      <%= link_to "View all →", inventory_items_path, class: "mt-5 inline-block text-sm font-semibold text-emerald-800 hover:text-emerald-950 hover:underline" %>
    </div>

    <div class="group rounded-[24px] border border-amber-300 bg-white/95 backdrop-blur-sm/95 p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg transition">
      <div class="mb-4 h-1.5 w-14 rounded-full bg-stone-200"></div>
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-emerald-900/60">Total Batches</p>
      <p class="mt-4 text-4xl font-extrabold text-emerald-950"><%= @stats[:batches] %></p>
      <%= link_to "View all →", batches_path, class: "mt-5 inline-block text-sm font-semibold text-emerald-800 hover:text-emerald-950 hover:underline" %>
    </div>
  </div>

  <!-- Main panels -->
  <div class="grid grid-cols-1 gap-8 xl:grid-cols-2">
    <!-- Recent Recipes -->
    <div>
      <div class="mb-4 flex items-center justify-between">
        <h2 class="text-2xl font-extrabold tracking-tight text-emerald-950">Recent Recipes</h2>
        <%= link_to "New Recipe", new_recipe_path,
          class: "rounded-full border border-rose-200 bg-rose-50 px-4 py-2 text-sm font-semibold text-rose-800 shadow-sm hover:bg-rose-100 transition" %>
      </div>

      <div class="overflow-hidden rounded-[24px] border border-amber-300 bg-white shadow-sm">
        <% @recent_recipes.each do |recipe| %>
          <div class="flex items-center justify-between border-b border-amber-300 px-5 py-5 last:border-b-0">
            <div>
              <%= link_to recipe.title, recipe, class: "text-lg font-semibold text-emerald-950 hover:text-emerald-800 hover:underline" %>
              <p class="mt-1 text-sm text-stone-500"><%= recipe.product_type %></p>
            </div>
            <span class="text-sm font-medium text-stone-400"><%= recipe.created_at.strftime("%b %d") %></span>
          </div>
        <% end %>

        <% if @recent_recipes.empty? %>
          <div class="p-10 text-center">
            <p class="mb-4 text-stone-500">No recipes yet.</p>
            <%= link_to "Create your first recipe", new_recipe_path,
              class: "font-semibold text-emerald-800 hover:text-emerald-950 hover:underline" %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Recent Batches -->
    <div>
      <div class="mb-4 flex items-center justify-between">
        <h2 class="text-2xl font-extrabold tracking-tight text-emerald-950">Recent Batches</h2>
        <%= link_to "Log Batch", new_batch_path,
          class: "rounded-full border border-rose-200 bg-rose-50 px-4 py-2 text-sm font-semibold text-rose-800 shadow-sm hover:bg-rose-100 transition" %>
      </div>

      <div class="overflow-hidden rounded-[24px] border border-amber-300 bg-white shadow-sm">
        <% @recent_batches.each do |batch| %>
          <div class="flex items-center justify-between border-b border-amber-300 px-5 py-5 last:border-b-0">
            <div>
              <p class="text-lg font-semibold text-emerald-950"><%= batch.recipe.title %></p>
              <p class="mt-1 text-sm italic text-stone-500"><%= batch.notes.truncate(55) if batch.notes.present? %></p>
            </div>
            <div class="text-right">
              <span class="block text-sm font-medium text-stone-400"><%= batch.made_on.strftime("%b %d") %></span>
              <%= link_to "Details", batch, class: "mt-1 inline-block text-xs font-semibold text-emerald-800 hover:text-emerald-950 hover:underline" %>
            </div>
          </div>
        <% end %>

        <% if @recent_batches.empty? %>
          <div class="p-10 text-center">
            <p class="mb-4 text-stone-500">No batches logged yet.</p>
            <%= link_to "Log your first batch", new_batch_path,
              class: "font-semibold text-emerald-800 hover:text-emerald-950 hover:underline" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Quick Actions -->
  <div class="mt-12 rounded-[28px] border border-amber-300 bg-gradient-to-br from-rose-150/60 via-pink-100 to-rose-100 p-8 shadow-sm">
    <h2 class="mb-6 text-center text-2xl font-extrabold tracking-tight text-emerald-950">
      Quick Actions
    </h2>

    <div class="flex flex-wrap justify-center gap-4">
      <%= link_to "Add New Ingredient", new_ingredient_path,
        class: "rounded-2xl border border-amber-300 bg-white px-6 py-3 font-semibold text-stone-700 shadow-sm transition hover:-translate-y-0.5 hover:bg-amber-50 hover:shadow-md" %>

      <%= link_to "Record Purchase", new_inventory_item_path,
        class: "rounded-2xl border border-amber-300 bg-white px-6 py-3 font-semibold text-stone-700 shadow-sm transition hover:-translate-y-0.5 hover:bg-amber-50 hover:shadow-md" %>

      <%= link_to "Create Recipe", new_recipe_path,
        class: "rounded-2xl border border-amber-300 bg-white px-6 py-3 font-semibold text-stone-700 shadow-sm transition hover:-translate-y-0.5 hover:bg-amber-50 hover:shadow-md" %>

      <%= link_to "Log Production", new_batch_path,
        class: "rounded-2xl border border-amber-300 bg-white px-6 py-3 font-semibold text-stone-700 shadow-sm transition hover:-translate-y-0.5 hover:bg-amber-50 hover:shadow-md" %>
    </div>
  </div>
</div>