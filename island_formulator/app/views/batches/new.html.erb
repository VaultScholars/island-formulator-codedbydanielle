<% content_for :title, "Log a New Batch" %>

<div class="mx-auto w-full max-w-3xl px-5 py-10">
  <div class="mb-8 flex items-start justify-between gap-4">
    <div>
      <p class="text-sm font-semibold tracking-wide text-emerald-900/80 uppercase">
        Batch History
      </p>
      <h1 class="mt-2 text-4xl font-extrabold text-emerald-950">
        Log a New Batch
      </h1>
      <p class="mt-2 text-sm text-stone-600">
        Record when you made a recipe and note any adjustments, texture, scent, or results.
      </p>
    </div>

    <%= link_to "Back",
      batches_path,
      class: "inline-flex items-center justify-center rounded-md border border-amber-200 bg-white px-4 py-2 text-sm font-semibold text-stone-700 hover:bg-amber-50" %>
  </div>

  <%= form_with(model: @batch, class: "space-y-6") do |form| %>
    <% if @batch.errors.any? %>
      <div class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-rose-900">
        <h2 class="font-semibold">
          <%= pluralize(@batch.errors.count, "error") %> prohibited this batch from being saved:
        </h2>
        <ul class="mt-2 list-disc pl-5 text-sm text-rose-800">
          <% @batch.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="rounded-2xl border border-amber-200 bg-rose-50/40 p-6 shadow-sm">
      <div class="grid grid-cols-1 gap-6">
        <div>
          <%= form.label :recipe_id, "Which Recipe?",
            class: "block text-sm font-semibold text-emerald-950" %>

          <%= form.collection_select :recipe_id,
            current_user.recipes.order(:title),
            :id,
            :title,
            { prompt: "Select a recipe" },
            {
              class: "mt-2 block w-full rounded-md border border-amber-100 bg-white/80 px-3 py-2 shadow-sm focus:outline-none focus:ring-2 focus:ring-emerald-700/30 focus:border-emerald-700"
            } %>
        </div>

        <div>
          <%= form.label :made_on, "Date Made",
            class: "block text-sm font-semibold text-emerald-950" %>

          <%= form.date_field :made_on,
            class: "mt-2 block w-full rounded-md border border-amber-100 bg-white/80 px-3 py-2 shadow-sm focus:outline-none focus:ring-2 focus:ring-emerald-700/30 focus:border-emerald-700" %>
        </div>

        <div>
          <%= form.label :notes, "Production Notes (How did it go? Any adjustments?)",
            class: "block text-sm font-semibold text-emerald-950" %>

          <%= form.text_area :notes,
            rows: 6,
            placeholder: "e.g. Added a bit more lavender oil for scent. Consistency is perfect.",
            class: "mt-2 block w-full rounded-md border border-amber-100 bg-white/80 px-3 py-2 shadow-sm placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-emerald-700/30 focus:border-emerald-700" %>
        </div>
      </div>

      <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-xs text-stone-600">
          Tip: Use production notes to track scent, texture, substitutions, and batch results.
        </p>

        <div class="flex gap-3">
          <%= link_to "Cancel",
            batches_path,
            class: "inline-flex items-center justify-center rounded-md border border-amber-200 bg-white px-4 py-2 text-sm font-semibold text-stone-700 hover:bg-amber-50 transition" %>

          <%= form.submit "Log Batch",
            class: "inline-flex items-center justify-center rounded-md bg-emerald-900 px-5 py-2 text-sm font-semibold text-rose-50 shadow-sm hover:bg-emerald-800 focus:outline-none focus:ring-2 focus:ring-emerald-700/40 transition" %>
        </div>
      </div>
    </div>
  <% end %>
</div>