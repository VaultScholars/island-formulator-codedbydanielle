<% content_for :title, @ingredient.name %>

<div class="mx-auto w-full max-w-6xl px-5 py-10">
  <div class="rounded-[2rem] border border-amber-200 bg-white/90 shadow-xl overflow-hidden">
    <div class="grid grid-cols-1 lg:grid-cols-2">
      
      <!-- Left: Image -->
      <div class="relative h-full min-h-[320px] bg-gradient-to-br from-emerald-50 via-white to-rose-50">
        <% if @ingredient.photo.attached? %>
          <%= image_tag @ingredient.photo,
            class: "h-full w-full object-cover" %>
        <% else %>
          <div class="flex h-full min-h-[320px] items-center justify-center">
            <div class="rounded-2xl border border-amber-200 bg-white/80 px-6 py-4 text-center shadow-sm">
              <p class="text-sm font-semibold uppercase tracking-wide text-stone-400">
                No Image Uploaded
              </p>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Right: Content -->
      <div class="flex flex-col justify-between bg-gradient-to-br from-white via-rose-50/40 to-emerald-50/30 p-8 lg:p-10">
        <div>
          <!-- Header -->
          <div class="mb-8 flex flex-wrap items-start justify-between gap-4">
            <div>
              <p class="text-sm font-semibold tracking-[0.2em] text-emerald-800/80 uppercase">
                Ingredient Profile
              </p>

              <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-emerald-950">
                <%= @ingredient.name %>
              </h1>

              <% if @ingredient.category.present? %>
                <div class="mt-4">
                  <span class="inline-flex items-center rounded-full border border-emerald-200 bg-emerald-100 px-4 py-1.5 text-sm font-semibold uppercase tracking-wide text-emerald-900 shadow-sm">
                    <%= @ingredient.category %>
                  </span>
                </div>
              <% end %>
            </div>

            <div class="flex gap-3">
              <%= link_to "Edit Ingredient",
                edit_ingredient_path(@ingredient),
                class: "inline-flex items-center justify-center rounded-md bg-emerald-900 px-4 py-2.5 text-sm font-semibold text-rose-50 shadow-sm hover:bg-emerald-800 transition" %>

              <%= button_to "Delete Ingredient",
                @ingredient,
                method: :delete,
                data: { turbo_confirm: "Are you sure you want to delete this ingredient?" },
                class: "inline-flex items-center justify-center rounded-md border border-rose-200 bg-rose-50 px-4 py-2.5 text-sm font-semibold text-rose-700 hover:bg-rose-100 transition" %>
            </div>
          </div>

          <!-- Description -->
          <div class="mb-5 rounded-2xl border border-amber-100 bg-white/80 p-5 shadow-sm">
            <p class="mb-2 text-xs font-bold uppercase tracking-[0.18em] text-emerald-800/70">
              Description
            </p>
            <p class="text-base leading-relaxed text-stone-700">
              <%= @ingredient.description.presence || "No description added yet." %>
            </p>
          </div>

          <!-- Notes -->
          <div class="mb-5 rounded-2xl border border-amber-100 bg-white/80 p-5 shadow-sm">
            <p class="mb-2 text-xs font-bold uppercase tracking-[0.18em] text-emerald-800/70">
              Notes
            </p>
            <p class="text-base leading-relaxed text-stone-700">
              <%= @ingredient.notes.presence || "No notes added yet." %>
            </p>
          </div>

          <!-- Benefits & Properties -->
          <% if @ingredient.tags.any? %>
            <div class="rounded-2xl border border-amber-100 bg-white/80 p-5 shadow-sm">
              <p class="mb-4 text-xs font-bold uppercase tracking-[0.18em] text-emerald-800/70">
                Benefits & Properties
              </p>

              <div class="flex flex-wrap gap-3">
                <% @ingredient.tags.each do |tag| %>
                  <span class="inline-flex items-center rounded-full border border-emerald-200 bg-emerald-50 px-4 py-1.5 text-sm font-semibold text-emerald-900 shadow-sm">
                    <%= tag.name %>
                  </span>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>

        <!-- Footer -->
        <div class="mt-8 border-t border-amber-200 pt-6">
          <%= link_to "Back",
            ingredients_path,
            class: "inline-flex items-center justify-center rounded-md border border-amber-200 bg-white px-4 py-2 text-sm font-semibold text-stone-700 hover:bg-amber-50 transition" %>
        </div>
      </div>
    </div>
  </div>
</div>