<% content_for :title, "Inventory" %>

<div class="mx-auto w-full max-w-6xl px-5 py-10">
  <% if notice.present? %>
    <p id="notice"
       class="mb-6 inline-block rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-2 text-sm font-semibold text-emerald-800">
      <%= notice %>
    </p>
  <% end %>

  <div class="mb-8 flex items-start justify-between gap-4">
    <div>
      <p class="text-sm font-semibold tracking-wide text-emerald-900/80 uppercase">
        Inventory Tracking
      </p>
      <h1 class="mt-2 text-4xl font-extrabold text-emerald-950">
        Inventory
      </h1>
      <p class="mt-2 text-sm text-stone-600">
        Track the actual products and supplies on your shelf—brand, size, storage, and purchase date.
      </p>
    </div>

    <%= link_to "New Inventory Item",
      new_inventory_item_path,
      class: "rounded-lg bg-emerald-900 px-5 py-3 text-base font-semibold text-rose-50 shadow-sm transition hover:bg-emerald-800" %>
  </div>

  <div id="inventory_items" class="mt-8">
    <div class="overflow-x-auto rounded-2xl border border-amber-200 bg-white shadow-sm">
      <table class="min-w-full">
        <thead class="border-b border-amber-100 bg-rose-100/80">
          <tr>
            <th class="px-6 py-4 text-left text-xs font-bold uppercase tracking-widest text-emerald-900/70">
              Ingredient
            </th>
            <th class="px-6 py-4 text-left text-xs font-bold uppercase tracking-widest text-emerald-900/70">
              Brand
            </th>
            <th class="px-6 py-4 text-left text-xs font-bold uppercase tracking-widest text-emerald-900/70">
              Size
            </th>
            <th class="px-6 py-4 text-left text-xs font-bold uppercase tracking-widest text-emerald-900/70">
              Location
            </th>
            <th class="px-6 py-4 text-left text-xs font-bold uppercase tracking-widest text-emerald-900/70">
              Purchased
            </th>
            <th class="px-6 py-4 text-right text-xs font-bold uppercase tracking-widest text-emerald-900/70">
              Actions
            </th>
          </tr>
        </thead>

        <tbody class="divide-y divide-amber-100">
          <% @inventory_items.each do |item| %>
            <tr class="transition hover:bg-amber-50/40">
              <td class="whitespace-nowrap px-6 py-4 font-semibold text-emerald-950">
                <%= item.ingredient.name %>
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-stone-600">
                <%= item.brand.presence || "—" %>
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-stone-600">
                <%= [item.unit_size, item.unit].compact.join(" ").presence || "—" %>

              </td>
              <td class="whitespace-nowrap px-6 py-4 text-stone-600">
                <%= item.location.presence || "—" %>
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-stone-600">
                <%= item.purchase_date.strftime("%b %d, %Y") %>
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-right text-sm font-medium">
                <%= link_to "Show", item,
                  class: "mr-4 font-semibold text-emerald-800 hover:text-emerald-950 hover:underline" %>
                <%= link_to "Edit", edit_inventory_item_path(item),
                  class: "font-semibold text-stone-600 hover:text-stone-900 hover:underline" %>
              </td>
            </tr>
          <% end %>

          <% if @inventory_items.empty? %>
            <tr>
              <td colspan="6" class="px-6 py-12 text-center">
                <p class="text-stone-500">No inventory items yet.</p>
                <%= link_to "Add your first inventory item", new_inventory_item_path,
                  class: "mt-3 inline-block font-semibold text-emerald-800 hover:text-emerald-950 hover:underline" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>