<div class="mx-auto max-w-5xl px-6 py-10">
  <div class="mb-8 flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
    <div>
      <h1 class="text-4xl font-extrabold text-emerald-950"><%= @recipe.title %></h1>
      <span class="mt-3 inline-block rounded-full border border-emerald-200 bg-emerald-100 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-emerald-900">
        <%= @recipe.product_type %>
      </span>
    </div>

    <div class="flex gap-3">
      <%= link_to "Edit", edit_recipe_path(@recipe),
        class: "rounded-lg bg-emerald-900 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-emerald-800 transition" %>

      <%= link_to "Back", recipes_path,
        class: "rounded-lg border border-amber-200 bg-white px-5 py-2.5 text-sm font-semibold text-stone-700 hover:bg-amber-50 transition" %>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
    <div class="md:col-span-1">
      <% if @recipe.photo.attached? %>
        <%= image_tag @recipe.photo, class: "w-full h-auto object-cover rounded-2xl shadow-sm border border-amber-200" %>
      <% else %>
        <div class="flex h-64 w-full items-center justify-center rounded-2xl border border-amber-200 bg-rose-50/60 text-sm italic text-stone-400">
          No photo uploaded
        </div>
      <% end %>

      <div class="mt-8 rounded-2xl border border-amber-200 bg-white p-6 shadow-sm">
        <h2 class="mb-4 border-b border-amber-100 pb-3 text-xl font-extrabold text-emerald-950">
          Ingredients
        </h2>

        <ul class="space-y-3">
          <% @recipe.recipe_ingredients.each do |ri| %>
            <li class="flex items-center justify-between">
              <span class="font-medium text-stone-700"><%= ri.ingredient.name %></span>
              <span class="rounded-md bg-rose-50 px-2.5 py-1 text-sm font-medium text-stone-600 border border-amber-100">
                <%= ri.quantity %>
              </span>
            </li>
          <% end %>
        </ul>
      </div>
    </div>

    <div class="md:col-span-2">
      <div class="h-full rounded-2xl border border-amber-200 bg-white p-8 shadow-sm">
        <h2 class="mb-4 text-2xl font-extrabold text-emerald-950">Method</h2>
        <div class="prose max-w-none leading-relaxed text-stone-700">
          <%= simple_format @recipe.method %>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-8 flex flex-wrap gap-3">
    <%= link_to "Log a New Batch", new_batch_path(recipe_id: @recipe.id),
      class: "rounded-lg bg-rose-100 px-5 py-2.5 text-sm font-semibold text-rose-800 border border-rose-200 shadow-sm hover:bg-rose-200 transition" %>

    <%= button_to "Destroy this recipe", @recipe,
      method: :delete,
      class: "rounded-lg bg-red-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-red-500 transition",
      data: { turbo_confirm: "Are you sure?" } %>
  </div>
</div>