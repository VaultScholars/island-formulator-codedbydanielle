<% content_for :title, "Create Account" %>

<div class="mx-auto w-full max-w-md px-5 py-16">

  <div class="rounded-2xl border border-amber-200 bg-white/90 p-8 shadow-sm">

    <div class="mb-8 text-center">
      <p class="text-sm font-semibold tracking-wide text-emerald-900/80 uppercase">
        Island Formulator
      </p>

      <h1 class="mt-2 text-3xl font-extrabold text-emerald-950">
        Create Your Account
      </h1>

      <p class="mt-2 text-sm text-stone-600">
        Start building your formulation lab and tracking your recipes.
      </p>
    </div>

    <%= form_with model: @user, url: users_path, class: "space-y-5" do |form| %>

      <% if @user.errors.any? %>
        <div class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-rose-900">
          <ul class="list-disc list-inside text-sm">
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= form.label :email_address,
          class: "block text-sm font-semibold text-emerald-950 mb-1" %>

        <%= form.email_field :email_address,
          placeholder: "you@example.com",
          required: true,
          class: "w-full rounded-md border border-amber-100 bg-white/80 px-3 py-2 shadow-sm placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-emerald-700/30 focus:border-emerald-700" %>
      </div>

      <div>
        <%= form.label :password,
          class: "block text-sm font-semibold text-emerald-950 mb-1" %>

        <%= form.password_field :password,
          placeholder: "Choose a strong password",
          required: true,
          class: "w-full rounded-md border border-amber-100 bg-white/80 px-3 py-2 shadow-sm placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-emerald-700/30 focus:border-emerald-700" %>
      </div>

      <div>
        <%= form.label :password_confirmation, "Confirm Password",
          class: "block text-sm font-semibold text-emerald-950 mb-1" %>

        <%= form.password_field :password_confirmation,
          placeholder: "Type your password again",
          required: true,
          class: "w-full rounded-md border border-amber-100 bg-white/80 px-3 py-2 shadow-sm placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-emerald-700/30 focus:border-emerald-700" %>
      </div>

      <%= form.submit "Create Account",
        class: "w-full rounded-md bg-emerald-900 px-5 py-2.5 text-sm font-semibold text-rose-50 shadow-sm hover:bg-emerald-800 focus:outline-none focus:ring-2 focus:ring-emerald-700/40 transition" %>

    <% end %>

    <div class="mt-6 text-center text-sm text-stone-600">
      Already have an account?
      <%= link_to "Log in",
        new_session_path,
        class: "font-semibold text-emerald-700 hover:text-emerald-950 hover:underline" %>
    </div>

  </div>

</div>