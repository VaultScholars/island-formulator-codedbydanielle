<%= form_with(model: inventory_item, class: "space-y-6") do |form| %>

  <% if inventory_item.errors.any? %>
    <div class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-rose-900">
      <h2 class="font-semibold">
        <%= pluralize(inventory_item.errors.count, "error") %> prohibited this item from being saved:
      </h2>
      <ul class="mt-2 list-disc pl-5 text-sm text-rose-800">
        <% inventory_item.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="rounded-2xl border border-amber-200 bg-rose-50/40 p-6 shadow-sm">

    <div class="grid grid-cols-1 gap-6">

      <!-- Ingredient -->
      <div>
        <%= form.label :ingredient_id, "Which Ingredient?",
          class: "block text-sm font-semibold text-emerald-950" %>

        <%= form.collection_select :ingredient_id,
          Ingredient.order(:name),
          :id,
          :name,
          { prompt: "Select an ingredient" },
          {
            class: "mt-2 block w-full rounded-md border border-amber-100 bg-white/80 px-3 py-2 shadow-sm focus:outline-none focus:ring-2 focus:ring-emerald-700/30 focus:border-emerald-700"
          } %>
      </div>

      <!-- Brand -->
      <div>
        <%= form.label :brand,
          class: "block text-sm font-semibold text-emerald-950" %>

        <%= form.text_field :brand,
          placeholder: "e.g., Sky Organics",
          class: "mt-2 block w-full rounded-md border border-amber-100 bg-white/80 px-3 py-2 shadow-sm placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-emerald-700/30 focus:border-emerald-700" %>
      </div>

     

      <!-- Location -->
      <div>
        <%= form.label :location, "Where is it stored?",
          class: "block text-sm font-semibold text-emerald-950" %>

        <%= form.text_field :location,
          placeholder: "e.g., Bathroom shelf, Storage bin",
          class: "mt-2 block w-full rounded-md border border-amber-100 bg-white/80 px-3 py-2 shadow-sm placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-emerald-700/30 focus:border-emerald-700" %>
      </div>

      <!-- Purchase Date -->
      <div>
        <%= form.label :purchase_date,
          class: "block text-sm font-semibold text-emerald-950" %>

        <%= form.date_field :purchase_date,
          class: "mt-2 block w-full rounded-md border border-amber-100 bg-white/80 px-3 py-2 shadow-sm focus:outline-none focus:ring-2 focus:ring-emerald-700/30 focus:border-emerald-700" %>
      </div>

      <!-- Cost Calculator -->
      <div>
        <%= form.label :cost, class: "block text-sm font-semibold text-emerald-950" %>
        <%= form.number_field :cost,
          step: "0.01",
          placeholder: "e.g., 12.99",
          class: "mt-2 block w-full rounded-md border border-amber-100 bg-white/80 px-3 py-2 shadow-sm placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-emerald-700/30 focus:border-emerald-700" %>
      </div>

      <div>
        <%= form.label :unit_size, "Container Size", class: "block text-sm font-semibold text-emerald-950" %>
        <%= form.number_field :unit_size,
          step: "0.01",
          placeholder: "e.g., 500",
          class: "mt-2 block w-full rounded-md border border-amber-100 bg-white/80 px-3 py-2 shadow-sm placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-emerald-700/30 focus:border-emerald-700" %>
      </div>

      <div>
        <%= form.label :unit, class: "block text-sm font-semibold text-emerald-950" %>
        <%= form.select :unit,
          options_for_select([["ml", "ml"], ["g", "g"]], inventory_item.unit),
          { prompt: "Select unit" },
          class: "mt-2 block w-full rounded-md border border-amber-100 bg-white/80 px-3 py-2 shadow-sm focus:outline-none focus:ring-2 focus:ring-emerald-700/30 focus:border-emerald-700" %>
      </div>

      <!-- Notes -->
      <div>
        <%= form.label :notes,
          class: "block text-sm font-semibold text-emerald-950" %>

        <%= form.text_area :notes,
          rows: 4,
          placeholder: "Add any notes about this purchase...",
          class: "mt-2 block w-full rounded-md border border-amber-100 bg-white/80 px-3 py-2 shadow-sm placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-emerald-700/30 focus:border-emerald-700" %>
      </div>

      <!-- Photo Upload -->
      <div class="rounded-2xl border border-amber-200 bg-white/80 p-6 shadow-sm">

        <%= form.label :photo, "Photo (receipt or bottle)",
          class: "block text-sm font-semibold text-emerald-950 mb-3" %>

        <div class="flex items-center justify-center w-full">
          <label class="flex h-36 w-full cursor-pointer flex-col items-center justify-center rounded-2xl border-2 border-dashed border-amber-200 bg-rose-50/40 hover:bg-rose-100 transition">

            <div class="flex flex-col items-center justify-center pt-5 pb-6">

              <svg class="mb-4 h-8 w-8 text-stone-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 16">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M13 13h3a3 3 0 0 0 0-6h-.025A5.56 5.56 0 0 0 16 6.5
                5.5 5.5 0 0 0 5.207 5.021C5.137 5.017 5.071 5 5 5
                a4 4 0 0 0 0 8h2.167M10 15V6m0 0L8 8m2-2 2 2"/>
              </svg>

              <p class="mb-2 text-sm text-stone-500">
                <span class="font-semibold">Click to upload</span> or drag and drop
              </p>

              <p class="text-xs text-stone-400">
                PNG, JPG or GIF
              </p>

            </div>

            <%= form.file_field :photo, accept: "image/*", class: "hidden" %>

          </label>
        </div>

        <% if inventory_item.photo.attached? %>
          <p class="mt-3 text-sm font-medium text-emerald-700">
            ✓ Current photo: <%= inventory_item.photo.filename %>
          </p>
        <% end %>

      </div>

    </div>

    <!-- Footer -->
    <div class="mt-6 flex items-center justify-between">

      <p class="text-xs text-stone-600">
        Tip: Track size and location so you always know what’s available.
      </p>

      <%= form.submit(
        inventory_item.persisted? ? "Update Inventory Item" : "Create Inventory Item",
        class: "inline-flex items-center justify-center rounded-md bg-emerald-900 px-5 py-2 text-sm font-semibold text-rose-50 shadow-sm hover:bg-emerald-800 focus:outline-none focus:ring-2 focus:ring-emerald-700/40"
      ) %>

    </div>

  </div>

<% end %>